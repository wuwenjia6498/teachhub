# AIHUBMIX 平台 API Key（用于上传时调用 Gemini 生成文档摘要）
# 前往 https://aihubmix.com 注册并获取 Key，填入下方
AIHUBMIX_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 管理后台密码
ADMIN_PASSWORD=your_password_here

# Upstash Redis 连接信息（替代原 Vercel KV）
# 在 Vercel 控制台 Storage → Create Database → Upstash → Redis 创建后，
# 进入数据库 → .env.local 一键复制以下两项
UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
